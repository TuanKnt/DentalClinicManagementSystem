{
  "baseUrlEnv": "SRS_BASE_URL",
  "usernameEnv": "SRS_USERNAME",
  "passwordEnv": "SRS_PASSWORD",
  "loginPathEnv": "SRS_LOGIN_PATH",
  "defaults": {
    "loginPath": "/login",
    "usernameSelectors": [
      "input[name='username']",
      "input[name='userName']",
      "input[name='email']",
      "input[type='email']"
    ],
    "passwordSelectors": [
      "input[name='password']",
      "input[type='password']"
    ],
    "submitSelectors": [
      "button[type='submit']",
      "input[type='submit']"
    ]
  },
  "screenshot": {
    "fullPage": true,
    "waitAfterNavigationMs": 800,
    "hideSelectors": []
  }
}